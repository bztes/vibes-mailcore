# Uncommented variables are required, commented ones are optional (default shown).
# Secrets: generate each with `openssl rand -hex 24`.
# Ports: host ports, change them if something else already listens there.
# Volumes: a docker volume name (default) or a host path such as ./data/postgres
# (must start with ./ or /).
# Features: apply with `docker compose up -d`. A wrong value stops that service
# with a message saying what is expected (see `docker compose logs`).
# "dev:" marks the value for local development (`pnpm dev`, see README).

# Postgres connection string, only needed for `pnpm dev`
# APP_DATABASE_URL=postgres://mailcore:<POSTGRES_PASSWORD>@localhost:5432/mailcore

# Feature: size limit pre-filled for new mailboxes
# APP_DEFAULT_MAILBOX_GB=5

# Doveadm HTTP API, only needed for `pnpm dev`
# APP_DOVEADM_URL=http://localhost:8080

# Public URL of the admin UI (Caddy proxies it to 127.0.0.1:3000)
APP_ORIGIN=https://admin.example.com

# Port of the admin UI, only reachable from localhost
# APP_PORT=3000

# Redis, only needed for `pnpm dev`
# APP_REDIS_URL=redis://localhost:6379

# Feature: empty Junk and Trash after this many days, 0 = never
# DOVECOT_AUTO_DELETE_DAYS=30

# Secret for the doveadm HTTP API
DOVECOT_DOVEADM_PASSWORD=

# Port for IMAP over TLS
# DOVECOT_IMAPS_PORT=993

# Volume for the mailboxes (dev: ./data/mail)
# DOVECOT_MAIL_VOLUME=mail

# Directory where Caddy keeps the certificate for MAILCORE_HOSTNAME
# (contains MAILCORE_HOSTNAME.crt and MAILCORE_HOSTNAME.key). For Caddy installed
# from a distro package it is the path below. In dev (./data/certs),
# compose.dev.yml creates a self-signed one there.
MAILCORE_CERT_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.example.com

# Public hostname of the mail server. MX records point here, Caddy issues its cert.
MAILCORE_HOSTNAME=mail.example.com

# Image version to run (a release such as 1.2.3 or 1.2)
# MAILCORE_VERSION=latest

# Volume for the outgoing mail queue (dev: ./data/postfix-queue)
# POSTFIX_QUEUE_VOLUME=postfix-queue

# Port for incoming mail (SMTP)
# POSTFIX_SMTP_PORT=25

# Port for sending mail with STARTTLS
# POSTFIX_SUBMISSION_PORT=587

# Port for sending mail over TLS
# POSTFIX_SUBMISSIONS_PORT=465

# Secret for the read-only database role postfix and dovecot use
POSTGRES_MAILSERVER_PASSWORD=

# Secret for the database owner (the app)
POSTGRES_PASSWORD=

# Port of postgres on localhost, only used by compose.dev.yml
# POSTGRES_PORT=5432

# Volume for the database (dev: ./data/postgres)
# POSTGRES_VOLUME=postgres

# Volume for redis (DKIM keys, spam statistics) (dev: ./data/redis)
# REDIS_VOLUME=redis

# Feature: on = delay mail from unknown senders by a few minutes
# RSPAMD_GREYLISTING=off

# Feature: reject mail at this spam score (above 6; lower = stricter)
# RSPAMD_SPAM_REJECT_SCORE=15

# Volume for rspamd data. rspamd runs as uid 11333, so a host path must be
# writable by that user.
# RSPAMD_VOLUME=rspamd
