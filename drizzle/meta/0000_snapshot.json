  "views": {
    "public.mail_aliases": {
      "columns": {
        "address": {
          "name": "address",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "destinations": {
          "name": "destinations",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n\tSELECT a.local_part || '@' || d.name AS address,\n\t       array_to_string(a.destinations, ',') AS destinations\n\tFROM alias a\n\tJOIN domain d ON d.id = a.domain_id\n\tWHERE a.active AND d.active AND d.verified_at IS NOT NULL\n\tUNION ALL\n\tSELECT m.local_part || '@' || d.name, m.local_part || '@' || d.name\n\tFROM mailbox m\n\tJOIN domain d ON d.id = m.domain_id\n\tWHERE m.active AND d.active AND d.verified_at IS NOT NULL\n",
      "name": "mail_aliases",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.mail_domains": {
      "columns": {
        "domain": {
          "name": "domain",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "SELECT name AS domain FROM domain WHERE active AND verified_at IS NOT NULL",
      "name": "mail_domains",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.mail_sender_logins": {
      "columns": {
        "address": {
          "name": "address",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "logins": {
          "name": "logins",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n\tSELECT address, string_agg(login, ',') AS logins\n\tFROM (\n\t\tSELECT m.local_part || '@' || d.name AS address, m.local_part || '@' || d.name AS login\n\t\tFROM mailbox m\n\t\tJOIN domain d ON d.id = m.domain_id\n\t\tWHERE m.active AND d.active AND d.verified_at IS NOT NULL\n\t\tUNION\n\t\tSELECT a.local_part || '@' || d.name, lower(dest)\n\t\tFROM alias a\n\t\tJOIN domain d ON d.id = a.domain_id\n\t\tCROSS JOIN LATERAL unnest(a.destinations) AS dest\n\t\tWHERE a.active AND d.active AND d.verified_at IS NOT NULL\n\t) s\n\tGROUP BY address\n",
      "name": "mail_sender_logins",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.mail_users": {
      "columns": {
        "address": {
          "name": "address",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "domain": {
          "name": "domain",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "local_part": {
          "name": "local_part",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "password": {
          "name": "password",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "quota_bytes": {
          "name": "quota_bytes",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n\tSELECT m.local_part || '@' || d.name AS address,\n\t       d.name AS domain,\n\t       m.local_part,\n\t       m.password_hash AS password,\n\t       m.quota_bytes\n\tFROM mailbox m\n\tJOIN domain d ON d.id = m.domain_id\n\tWHERE m.active AND d.active AND d.verified_at IS NOT NULL\n",
      "name": "mail_users",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
